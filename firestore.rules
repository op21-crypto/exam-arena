rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users Collection: Users can read & write strictly their own profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // 2. User Stats Collection: Public read for leaderboards/matchmaking, owner-only write
    match /user_stats/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // 3. Battles Collection: Multiplayer battle rooms and answers
    match /battles/{battleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.player1_id == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if false;

      match /answers/{answerId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Global Default Deny for any unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
